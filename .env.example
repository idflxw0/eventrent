# Copy this file to .env and fill in the values.
# cp .env.example .env

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_32_char_random_string
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate absolute URLs in CLI commands (emails, console, etc.)
DEFAULT_URI=http://localhost:8089
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker Compose: postgresql://eventrent:eventrent@127.0.0.1:5439/eventrent?serverVersion=16&charset=utf8
# Local Postgres:  postgresql://user:password@127.0.0.1:5432/eventrent?serverVersion=16&charset=utf8
DATABASE_URL=postgresql://eventrent:eventrent@127.0.0.1:5439/eventrent?serverVersion=16&charset=utf8
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Doctrine transport (default, no extra service needed):
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Redis (optional): redis://localhost:6379/messages
# RabbitMQ (optional): amqp://guest:guest@localhost:5672/%2f/messages
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit (Docker, port 1025): smtp://localhost:1025
# Mailtrap:  smtp://username:password@sandbox.smtp.mailtrap.io:2525
# Production: smtp://user:pass@smtp.example.com:587
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# Internal URL used by the PHP app to publish (Docker: http://mercure/.well-known/mercure)
MERCURE_URL=http://localhost:3000/.well-known/mercure
# Public URL used by the browser to subscribe (must be reachable from the client)
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Must match MERCURE_PUBLISHER_JWT_KEY and MERCURE_SUBSCRIBER_JWT_KEY in the Mercure hub
MERCURE_JWT_SECRET=change_me_mercure_jwt_secret
###< symfony/mercure-bundle ###

###> openweathermap ###
# Optional — leave empty to disable weather forecasts on outdoor reservations
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
###< openweathermap ###
