{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Devis en attente — EventRent{% endblock %}

{% block content_title %}Devis en attente{% endblock %}

{% block main %}
<style>
    /* Force dark theme on this page's table + empty states */
    .content-panel, .content-panel-body,
    .table-responsive, .datagrid,
    .datagrid tbody tr, .datagrid tbody td {
        background: transparent !important;
        color: inherit !important;
    }
    .datagrid thead th {
        background: rgba(255,255,255,0.04) !important;
        border-bottom: 1px solid rgba(255,255,255,0.08) !important;
        color: inherit !important;
    }
    .datagrid tbody tr + tr {
        border-top: 1px solid rgba(255,255,255,0.05) !important;
    }
    .datagrid.datagrid-empty tbody td {
        background: transparent !important;
    }
    .text-center.py-5 { color: var(--body-color, #9CA3AF) !important; }
</style>
<div class="content-panel">
    <div class="content-panel-body with-padding no-padding-bottom p-0">
        <div class="table-responsive">
            <table class="table datagrid {{ quotes is empty ? 'datagrid-empty' }}">
                <thead>
                    <tr>
                        <th class="align-middle">ID</th>
                        <th class="align-middle">Client</th>
                        <th class="align-middle">Date de début</th>
                        <th class="align-middle">Date de fin</th>
                        <th class="align-middle">Montant estimé</th>
                        <th class="align-middle">Équipements</th>
                        <th class="align-middle">Ville</th>
                        <th class="align-middle text-end" style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for q in quotes %}
                        <tr>
                            <td class="align-middle fw-bold">DEVIS-{{ '%04d'|format(q.id) }}</td>
                            <td class="align-middle">
                                <div><strong>{{ q.user.firstName }} {{ q.user.lastName }}</strong></div>
                                <div class="text-muted small">{{ q.user.email }}</div>
                            </td>
                            <td class="align-middle">{{ q.requestedStartDate|date('d/m/Y') }}</td>
                            <td class="align-middle">{{ q.requestedEndDate|date('d/m/Y') }}</td>
                            <td class="align-middle fw-bold text-success">{{ q.estimatedAmount }} €</td>
                            <td class="align-middle" style="max-width: 320px;">
                                <div class="d-flex flex-column gap-2">
                                    {% for line in q.lines %}
                                        <div class="small d-flex align-items-center">
                                            <span class="badge bg-secondary text-light me-2 px-2 py-1" style="font-size: 0.75rem; border: none !important; font-weight: 600;">{{ line.quantity }}x</span>
                                            <span class="text-light">{{ line.equipment.name }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="align-middle">{{ q.eventCity ?? '-' }}</td>
                            <td class="align-middle text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <form method="post" action="{{ path('admin_quote_approve', {id: q.id}) }}" class="d-inline m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ q.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success py-1 px-2" style="font-size: 0.8rem; background-color: #E55D1E; border-color: #E55D1E; color: #fff;">
                                            <i class="fas fa-check me-1"></i> Approuver
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_quote_reject', {id: q.id}) }}" class="d-inline m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ q.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.8rem; color: #fff; border-color: rgba(255,255,255,0.2);">
                                            <i class="fas fa-times me-1"></i> Refuser
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if quotes is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-inbox fa-3x mb-3 text-muted" aria-hidden="true"></i>
                <h5>Aucun devis en attente de traitement</h5>
                <p class="small mb-0">Tous les devis reçus ont été traités.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
