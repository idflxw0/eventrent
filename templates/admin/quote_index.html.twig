{% extends 'base.html.twig' %}

{% block title %}Gestion des devis — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('admin') }}">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Devis en attente</li>
            </ol>
        </nav>
        <h1>Devis en attente</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            {% for q in quotes %}
                <article class="er-reservation-card status-pending mb-3">
                    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                        <div>
                            <div class="er-res-title">DEVIS-{{ '%04d'|format(q.id) }}</div>
                            <div class="er-res-meta">
                                <i class="bi bi-person me-1" aria-hidden="true"></i> {{ q.user.firstName }} {{ q.user.lastName }}
                                &nbsp;·&nbsp;
                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i> {{ q.requestedStartDate|date('d/m/Y') }} – {{ q.requestedEndDate|date('d/m/Y') }}
                                {% if q.eventCity %}
                                    &nbsp;·&nbsp;
                                    <i class="bi bi-geo-alt me-1" aria-hidden="true"></i> {{ q.eventCity }}
                                {% endif %}
                            </div>
                            <div class="er-res-equipment">
                                {% for line in q.lines %}
                                    {{ line.equipment.name }} × {{ line.quantity }}{{ not loop.last ? ', ' : '' }}
                                {% endfor %}
                            </div>
                            <div class="er-res-total">{{ q.estimatedAmount }} €</div>
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <form method="post" action="{{ path('admin_quote_approve', {id: q.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ q.id) }}">
                                <button type="submit" class="btn-er-primary" style="font-size:.8125rem; padding:6px 14px;">
                                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Approuver
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_quote_reject', {id: q.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ q.id) }}">
                                <button type="submit" class="btn-er-danger-outline" style="font-size:.8125rem; padding:6px 14px;">
                                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Refuser
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            {% else %}
                <div class="er-empty" aria-live="polite">
                    <i class="bi bi-inbox er-empty-icon" aria-hidden="true"></i>
                    <div class="er-empty-title">Aucun devis en attente.</div>
                </div>
            {% endfor %}

        </div>
    </div>
</div>
{% endblock %}
