{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Créer un compte</h1>

            {{ form_start(registrationForm) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(registrationForm.firstName) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.lastName) }}</div>
                </div>
                {{ form_row(registrationForm.email) }}
                {{ form_row(registrationForm.phone) }}
                {{ form_row(registrationForm.plainPassword) }}

                <button type="submit" class="btn btn-primary">S'inscrire</button>
            {{ form_end(registrationForm) }}

            <p class="mt-3">
                Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
