{% extends 'base.html.twig' %}

{% block title %}Mes réservations — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mes réservations</li>
            </ol>
        </nav>
        <h1>Mes réservations</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <nav class="er-status-tabs mb-4" aria-label="Filtrer par statut">
                <a href="{{ path('reservation_index') }}" class="er-status-tab{{ not activeStatus ? ' active' : '' }}" aria-pressed="{{ not activeStatus ? 'true' : 'false' }}">Toutes</a>
                <a href="{{ path('reservation_index', {status: 'pending'}) }}" class="er-status-tab{{ activeStatus == 'pending' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'pending' ? 'true' : 'false' }}">En attente</a>
                <a href="{{ path('reservation_index', {status: 'confirmed'}) }}" class="er-status-tab{{ activeStatus == 'confirmed' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'confirmed' ? 'true' : 'false' }}">Confirmées</a>
                <a href="{{ path('reservation_index', {status: 'in_progress'}) }}" class="er-status-tab{{ activeStatus == 'in_progress' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'in_progress' ? 'true' : 'false' }}">En cours</a>
                <a href="{{ path('reservation_index', {status: 'completed'}) }}" class="er-status-tab{{ activeStatus == 'completed' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'completed' ? 'true' : 'false' }}">Terminées</a>
                <a href="{{ path('reservation_index', {status: 'cancelled'}) }}" class="er-status-tab{{ activeStatus == 'cancelled' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'cancelled' ? 'true' : 'false' }}">Annulées</a>
            </nav>

            {% for r in reservations %}
                {% set statusClass = r.status == 'confirmed' ? 'confirmed' : r.status == 'pending' ? 'pending' : r.status == 'cancelled' ? 'cancelled' : r.status == 'in_progress' ? 'in-progress' : 'completed' %}
                {% set badgeClass = statusClass %}
                {% set statusLabel = r.status == 'confirmed' ? 'Confirmée' : r.status == 'pending' ? 'En attente' : r.status == 'cancelled' ? 'Annulée' : r.status == 'in_progress' ? 'En cours' : 'Terminée' %}
                <article class="er-res-card er-res-card-status-{{ badgeClass }}" aria-label="Réservation #{{ r.id }}">
                    <div class="er-res-body">
                        <div style="flex:1;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="er-res-id">RES-{{ '%04d'|format(r.id) }}</span>
                                <span class="er-badge er-badge-{{ badgeClass }}">
                                    <i class="bi bi-{{ r.status == 'confirmed' ? 'check-circle' : r.status == 'pending' ? 'clock' : r.status == 'cancelled' ? 'x-circle' : r.status == 'in_progress' ? 'play-circle' : 'check2-all' }}" aria-hidden="true"></i> {{ statusLabel }}
                                </span>
                            </div>
                            <h2 class="er-res-name mb-2" style="font-size:1.125rem; font-weight:700; margin: 4px 0;">
                                {% for line in r.lines %}
                                    {{ line.equipment.name }} <span style="color:var(--er-primary);">× {{ line.quantity }}</span>{{ not loop.last ? ', ' : '' }}
                                {% endfor %}
                            </h2>
                            <div class="er-res-meta">
                                <span class="me-3"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i> {{ r.startDate|date('d/m/Y') }} – {{ r.endDate|date('d/m/Y') }}</span>
                                <span><i class="bi bi-geo-alt me-1" aria-hidden="true"></i> {{ r.eventCity|upper }}</span>
                            </div>
                        </div>
                        
                        <div class="er-res-right-side">
                            <div class="text-md-end">
                                <div class="er-res-price">
                                    {{ r.totalAmount }} €
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ path('reservation_show', {id: r.id}) }}" class="btn-er-outline-dark text-decoration-none" style="padding:8px 16px; font-size:.825rem; display:inline-flex; align-items:center; gap:6px; border-radius:var(--radius-md); height:38px;">
                                    <i class="bi bi-eye" aria-hidden="true"></i> Voir le détail
                                </a>
                                {% if r.status == 'completed' %}
                                    <a href="#" class="btn-er-outline text-decoration-none" style="padding:8px 16px; font-size:.825rem; display:inline-flex; align-items:center; gap:6px; border-radius:var(--radius-md); height:38px;">
                                        <i class="bi bi-star" aria-hidden="true"></i> Avis
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </article>
            {% else %}
                <div class="er-empty" aria-live="polite">
                    <i class="bi bi-calendar3 er-empty-icon" aria-hidden="true"></i>
                    <div class="er-empty-title">Vous n'avez pas encore de réservation.</div>
                    <p class="er-empty-sub">Parcourez notre catalogue pour trouver le matériel idéal.</p>
                    <a href="{{ path('catalog_index') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Parcourir le catalogue
                    </a>
                </div>
            {% endfor %}

            <div class="mt-4 text-center">
                <a href="{{ path('reservation_new') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Nouvelle réservation
                </a>
            </div>

        </div>
    </div>
</div>

{% endblock %}
