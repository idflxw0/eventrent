{% extends 'base.html.twig' %}

{% block title %}Mes devis — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mes devis</li>
            </ol>
        </nav>
        <h1>Mes devis</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <nav class="er-status-tabs mb-4" aria-label="Filtrer par statut">
                <a href="{{ path('quote_index') }}" class="er-status-tab{{ not activeStatus ? ' active' : '' }}" aria-pressed="{{ not activeStatus ? 'true' : 'false' }}">Tous</a>
                <a href="{{ path('quote_index', {status: 'pending'}) }}" class="er-status-tab{{ activeStatus == 'pending' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'pending' ? 'true' : 'false' }}">En attente</a>
                <a href="{{ path('quote_index', {status: 'approved'}) }}" class="er-status-tab{{ activeStatus == 'approved' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'approved' ? 'true' : 'false' }}">Approuvés</a>
                <a href="{{ path('quote_index', {status: 'refused'}) }}" class="er-status-tab{{ activeStatus == 'refused' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'refused' ? 'true' : 'false' }}">Refusés</a>
                <a href="{{ path('quote_index', {status: 'expired'}) }}" class="er-status-tab{{ activeStatus == 'expired' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'expired' ? 'true' : 'false' }}">Expirés</a>
            </nav>

            {% for q in quotes %}
                {% set badgeClass = q.status == 'approved' ? 'approved' : (q.status == 'pending' ? 'pending' : (q.status in ['refused','cancelled'] ? 'refused' : 'expired')) %}
                {% set statusIcon = q.status == 'approved' ? 'check-circle' : (q.status == 'pending' ? 'clock' : (q.status in ['refused','cancelled'] ? 'x-circle' : 'hourglass')) %}
                {% set statusLabel = q.status == 'approved' ? 'Approuvé' : (q.status == 'pending' ? 'En attente' : (q.status == 'refused' ? 'Refusé' : (q.status == 'cancelled' ? 'Refusé' : 'Expiré'))) %}
                <article class="er-res-card er-res-card-status-{{ badgeClass }}" aria-label="Devis #{{ q.id }}">
                    <div class="er-res-body">
                        <div style="flex:1;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="er-res-id">DEVIS-{{ '%04d'|format(q.id) }}</span>
                                <span class="er-badge er-badge-{{ badgeClass }}">
                                    <i class="bi bi-{{ statusIcon }}" aria-hidden="true"></i> {{ statusLabel }}
                                </span>
                            </div>
                            <h2 class="er-res-name mb-2" style="font-size:1.125rem; font-weight:700; margin: 4px 0;">
                                {% for line in q.lines %}
                                    {{ line.equipment.name }} <span style="color:var(--er-primary);">× {{ line.quantity }}</span>{{ not loop.last ? ', ' : '' }}
                                {% endfor %}
                            </h2>
                            <div class="er-res-meta">
                                <span class="me-3"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i> {{ q.requestedStartDate|date('d/m/Y') }} – {{ q.requestedEndDate|date('d/m/Y') }}</span>
                                {% if q.eventCity %}
                                    <span><i class="bi bi-geo-alt me-1" aria-hidden="true"></i> {{ q.eventCity|upper }}</span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="er-res-right-side">
                            <div class="text-md-end">
                                <div class="er-res-price">
                                    {{ q.estimatedAmount }} €
                                </div>
                                <div style="font-size:.72rem; color:var(--er-muted-text); margin-top:2px;">estimé</div>
                            </div>
                            <a href="{{ path('quote_show', {id: q.id}) }}" class="btn-er-outline-dark text-decoration-none" style="padding:8px 16px; font-size:.825rem; display:inline-flex; align-items:center; gap:6px; border-radius:var(--radius-md); height:38px;">
                                <i class="bi bi-eye" aria-hidden="true"></i> Voir le détail
                            </a>
                        </div>
                    </div>
                </article>
            {% else %}
                <div class="er-empty" aria-live="polite">
                    <i class="bi bi-file-earmark-text er-empty-icon" aria-hidden="true"></i>
                    <div class="er-empty-title">Vous n'avez pas encore de devis.</div>
                    <p class="er-empty-sub">Demandez un devis depuis la fiche d'un équipement.</p>
                    <a href="{{ path('catalog_index') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Parcourir le catalogue
                    </a>
                </div>
            {% endfor %}

            <div class="mt-4 text-center">
                <a href="{{ path('quote_new') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Nouveau devis
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}
