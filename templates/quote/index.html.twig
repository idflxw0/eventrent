{% extends 'base.html.twig' %}

{% block title %}Mes devis — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mes devis</li>
            </ol>
        </nav>
        <h1>Mes devis</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <nav class="er-tab-filter mb-4" aria-label="Filtrer par statut">
                <a href="{{ path('quote_index') }}" class="er-tab-btn{{ not activeStatus ? ' active' : '' }}" aria-pressed="{{ not activeStatus ? 'true' : 'false' }}">Tous</a>
                <a href="{{ path('quote_index', {status: 'pending'}) }}" class="er-tab-btn{{ activeStatus == 'pending' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'pending' ? 'true' : 'false' }}">En attente</a>
                <a href="{{ path('quote_index', {status: 'approved'}) }}" class="er-tab-btn{{ activeStatus == 'approved' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'approved' ? 'true' : 'false' }}">Approuvés</a>
                <a href="{{ path('quote_index', {status: 'rejected'}) }}" class="er-tab-btn{{ activeStatus == 'rejected' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'rejected' ? 'true' : 'false' }}">Refusés</a>
                <a href="{{ path('quote_index', {status: 'expired'}) }}" class="er-tab-btn{{ activeStatus == 'expired' ? ' active' : '' }}" aria-pressed="{{ activeStatus == 'expired' ? 'true' : 'false' }}">Expirés</a>
            </nav>

            {% for q in quotes %}
                {% set badgeClass = q.status == 'approved' ? 'approved' : q.status == 'pending' ? 'pending' : q.status == 'rejected' ? 'refused' : 'expired' %}
                {% set statusIcon = q.status == 'approved' ? 'check-circle' : q.status == 'pending' ? 'clock' : q.status == 'rejected' ? 'x-circle' : 'hourglass' %}
                {% set statusLabel = q.status == 'approved' ? 'Approuvé' : q.status == 'pending' ? 'En attente' : q.status == 'rejected' ? 'Refusé' : 'Expiré' %}
                <article class="er-reservation-card status-{{ badgeClass }}" aria-label="Devis #{{ q.id }}">
                    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                        <div>
                            <div class="er-res-title">DEVIS-{{ '%04d'|format(q.id) }}</div>
                            <div class="er-res-meta">
                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i> {{ q.requestedStartDate|date('d/m/Y') }} – {{ q.requestedEndDate|date('d/m/Y') }}
                                {% if q.eventCity %}
                                    &nbsp;·&nbsp;
                                    <i class="bi bi-geo-alt me-1" aria-hidden="true"></i> {{ q.eventCity }}
                                {% endif %}
                            </div>
                            <div class="er-res-equipment">
                                {% for line in q.lines %}
                                    {{ line.equipment.name }} × {{ line.quantity }}{{ not loop.last ? ', ' : '' }}
                                {% endfor %}
                            </div>
                            <div class="er-res-total">{{ q.estimatedAmount }} € <span style="font-size:.75rem; font-weight:400; color:var(--er-muted-text);">estimé</span></div>
                        </div>
                        <span class="er-badge er-badge-{{ badgeClass }} flex-shrink-0">
                            <i class="bi bi-{{ statusIcon }}" aria-hidden="true"></i> {{ statusLabel }}
                        </span>
                    </div>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <a href="{{ path('quote_show', {id: q.id}) }}" class="btn-er-primary text-decoration-none" style="display:inline-flex; align-items:center; gap:6px; padding:8px 16px; font-size:.875rem; border-radius:var(--radius-md);">
                            <i class="bi bi-eye" aria-hidden="true"></i> Voir le détail
                        </a>
                    </div>
                </article>
            {% else %}
                <div class="er-empty" aria-live="polite">
                    <i class="bi bi-file-earmark-text er-empty-icon" aria-hidden="true"></i>
                    <div class="er-empty-title">Vous n'avez pas encore de devis.</div>
                    <p class="er-empty-sub">Demandez un devis depuis la fiche d'un équipement.</p>
                    <a href="{{ path('catalog_index') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Parcourir le catalogue
                    </a>
                </div>
            {% endfor %}

            <div class="mt-4 text-center">
                <a href="{{ path('quote_new') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:8px; padding:12px 24px;">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Nouveau devis
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}
