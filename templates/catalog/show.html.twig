{% extends 'base.html.twig' %}

{% set isAudio = equipment.type == EqType.AUDIO %}
{% set isMaint = equipment.availabilityStatus == EqStatus.MAINTENANCE or equipment.availabilityStatus == EqStatus.OUT_OF_SERVICE %}
{% set availLabel = isMaint ? 'En maintenance' : 'Disponible' %}
{% set availClass = isMaint ? 'er-badge-maintenance' : 'er-badge-available' %}

{% block title %}{{ equipment.name }} — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('catalog_index') }}">Catalogue</a></li>
                <li class="breadcrumb-item"><a href="{{ path('catalog_index', {cat: equipment.category.id}) }}">{{ equipment.category.name }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ equipment.name }}</li>
            </ol>
        </nav>
        <h1>{{ equipment.name }}</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-7">

            <div class="er-detail-gallery mb-3" {% if equipment.photo %}style="background-image: url('{{ equipment.photo }}'); background-size: cover; background-position: center;"{% endif %}>
                {% if not equipment.photo %}
                    <i class="bi bi-{{ isAudio ? 'speaker' : 'projector' }} text-white" style="font-size:8rem; opacity:.15;"></i>
                {% endif %}
            </div>

            {% if not equipment.accessories.empty %}
            <div class="mt-4 mb-4">
                <h2 style="font-family:'Poppins',sans-serif; font-weight:600; font-size:1rem; margin-bottom:12px;">Accessoires compatibles :</h2>
                <div class="d-flex gap-2 flex-wrap">
                    {% for acc in equipment.accessories %}
                        <span class="er-accessory-chip"><i class="bi bi-plug" aria-hidden="true"></i> {{ acc.name }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <hr style="border-color:var(--er-border);">

            {% if equipment.description %}
            <div class="mt-4">
                <h2 style="font-family:'Poppins',sans-serif; font-weight:600; font-size:1.25rem; margin-bottom:12px;">À propos de cet équipement</h2>
                <p>{{ equipment.description }}</p>
            </div>
            {% endif %}

            <details class="er-specs-toggle mt-2 mb-4">
                <summary>
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                    Caractéristiques techniques
                </summary>
                <div class="mt-3 ps-3">
                    <dl class="er-spec-table row g-0">
                        {% if isAudio %}
                            <div class="col-6">
                                <dt>Puissance</dt>
                                <dd>{{ equipment.powerWatts }} W</dd>
                            </div>
                            <div class="col-6">
                                <dt>Connectique</dt>
                                <dd>{{ equipment.connectorType }}</dd>
                            </div>
                            <div class="col-6">
                                <dt>Canaux</dt>
                                <dd>{{ equipment.channelCount }}</dd>
                            </div>
                        {% else %}
                            <div class="col-6">
                                <dt>Résolution</dt>
                                <dd>{{ equipment.resolution }}</dd>
                            </div>
                            <div class="col-6">
                                <dt>Luminosité</dt>
                                <dd>{{ equipment.brightnessLumens }} lumens</dd>
                            </div>
                            <div class="col-6">
                                <dt>Type de projection</dt>
                                <dd>{{ equipment.projectionType }}</dd>
                            </div>
                        {% endif %}
                        <div class="col-6">
                            <dt>Référence</dt>
                            <dd>{{ equipment.reference }}</dd>
                        </div>
                        <div class="col-6">
                            <dt>Fournisseur</dt>
                            <dd>{{ equipment.supplier.name }}</dd>
                        </div>
                        <div class="col-6">
                            <dt>Ajouté le</dt>
                            <dd>{{ equipment.addedAt|date('d/m/Y') }}</dd>
                        </div>
                    </dl>
                </div>
            </details>

            <hr style="border-color:var(--er-border);">

            <div class="mt-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 style="font-family:'Poppins',sans-serif; font-weight:600; font-size:1.25rem; margin:0;">
                        Avis clients
                        <span style="color:var(--er-muted-text); font-size:1rem; font-weight:400;">({{ reviewCount }})</span>
                    </h2>
                    <div class="d-flex align-items-center gap-2">
                        {% if avgRating > 0 %}
                            <span class="er-equip-stars" aria-hidden="true">
                                {% for i in 1..5 %}
                                    {% if i <= avgRating|round(0, 'floor') %}<i class="bi bi-star-fill"></i>
                                    {% elseif i - 1 < avgRating %}<i class="bi bi-star-half"></i>
                                    {% else %}<i class="bi bi-star"></i>
                                    {% endif %}
                                {% endfor %}
                            </span>
                            <span style="font-weight:700; font-size:1rem;">{{ avgRating }}</span>
                            <span style="color:var(--er-muted-text); font-size:.875rem;">/ 5</span>
                        {% else %}
                            <span class="er-equip-stars" aria-hidden="true">
                                {% for i in 1..5 %}<i class="bi bi-star"></i>{% endfor %}
                            </span>
                            <span style="color:var(--er-muted-text); font-size:.875rem;">Aucun avis</span>
                        {% endif %}
                    </div>
                </div>

                {% for review in equipment.reviews %}
                    <div class="er-review-card">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="er-review-author">{{ review.user.firstName }} {{ review.user.lastName|first }}.</div>
                            <div class="er-review-stars" aria-label="{{ review.rating }} étoiles">
                                {% for i in 1..5 %}
                                    <i class="bi bi-star{{ i <= review.rating ? '-fill' : '' }}" aria-hidden="true"></i>
                                {% endfor %}
                            </div>
                        </div>
                        {% if review.comment %}<p class="er-review-text">"{{ review.comment }}"</p>{% endif %}
                        <div class="er-review-date">{{ review.createdAt|date('F Y') }}</div>
                    </div>
                {% else %}
                    <p class="text-muted">Aucun avis pour le moment.</p>
                {% endfor %}
            </div>
        </div>

        <div class="col-lg-5">
            <aside class="er-booking-panel" aria-label="Panneau de réservation">
                <div class="d-flex align-items-start justify-content-between mb-1">
                    <h2 style="font-family:'Poppins',sans-serif; font-weight:700; font-size:1.125rem; margin:0; flex:1;">{{ equipment.name }}</h2>
                </div>
                {% if avgRating > 0 %}
                    <div class="er-equip-stars mb-3" aria-label="{{ avgRating }} sur 5">
                        {% for i in 1..5 %}
                            {% if i <= avgRating|round(0, 'floor') %}<i class="bi bi-star-fill" aria-hidden="true"></i>
                            {% elseif i - 1 < avgRating %}<i class="bi bi-star-half" aria-hidden="true"></i>
                            {% else %}<i class="bi bi-star" aria-hidden="true"></i>
                            {% endif %}
                        {% endfor %}
                        <span class="ms-1" style="font-size:.875rem; color:var(--er-muted-text);">{{ avgRating }} ({{ reviewCount }} avis)</span>
                    </div>
                {% endif %}

                <div class="er-booking-price mb-3">{{ equipment.dailyPrice|number_format(0, ',', ' ') }} € <span>/ jour</span></div>

                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="er-badge {{ availClass }}">
                        {% if isMaint %}
                            <i class="bi bi-wrench" aria-hidden="true"></i> {{ availLabel }}
                        {% else %}
                            <i class="bi bi-circle-fill" style="font-size:.5rem;" aria-hidden="true"></i> {{ availLabel }}
                        {% endif %}
                    </span>
                    <span style="font-size:.8125rem; color:var(--er-muted-text);">Réf : {{ equipment.reference }}</span>
                </div>

                <div class="mb-4" style="font-size:.875rem; color:var(--er-muted-text);">
                    <i class="bi bi-building me-1" aria-hidden="true"></i> Fournisseur : <strong style="color:var(--er-foreground);">{{ equipment.supplier.name }}</strong>
                </div>

                <hr style="border-color:var(--er-border); margin:0 -24px 20px;">

                {% if isMaint %}
                    <button class="btn w-100 mb-2" disabled style="min-height:48px; background:var(--er-muted); color:var(--er-muted-text); border-radius:var(--radius-md); font-weight:600; cursor:not-allowed; border:none; font-family:'Poppins',sans-serif;">Indisponible</button>
                {% else %}
                    <a href="{{ path('reservation_new') }}" class="btn-er-accent w-100 mb-2 text-decoration-none text-center" style="display:flex; align-items:center; justify-content:center; gap:8px; font-size:1rem;">
                        <i class="bi bi-calendar-plus" aria-hidden="true"></i> Réserver
                    </a>
                    <a href="{{ path('quote_new', {equipment: equipment.id}) }}" class="btn-er-outline w-100 text-decoration-none text-center" style="display:flex; align-items:center; justify-content:center; gap:8px; font-size:.9375rem;">
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Demander un devis
                    </a>
                {% endif %}

                <hr style="border-color:var(--er-border); margin:20px -24px 16px;">
                <ul class="list-unstyled mb-0" style="font-size:.875rem; color:var(--er-muted-text);">
                    <li class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-truck" style="color:var(--er-primary);" aria-hidden="true"></i> Livraison sous 24h</li>
                    <li class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-shield-check" style="color:var(--er-primary);" aria-hidden="true"></i> Annulation gratuite sous 48h</li>
                    <li class="d-flex align-items-center gap-2"><i class="bi bi-telephone" style="color:var(--er-primary);" aria-hidden="true"></i> Support technique inclus</li>
                </ul>
            </aside>
        </div>
    </div>
</div>

<div class="er-mobile-booking-bar" aria-label="Barre de réservation mobile">
    <div>
        <div class="er-booking-price" style="font-size:1.25rem;">{{ equipment.dailyPrice|number_format(0, ',', ' ') }} €<span style="font-size:.875rem;"> / jour</span></div>
        <span class="er-badge {{ availClass }}" style="font-size:.7rem;">
            {% if isMaint %}<i class="bi bi-wrench" style="font-size:.4rem;" aria-hidden="true"></i> {{ availLabel }}{% else %}<i class="bi bi-circle-fill" style="font-size:.4rem;" aria-hidden="true"></i> {{ availLabel }}{% endif %}
        </span>
    </div>
    {% if not isMaint %}
        <a href="{{ path('reservation_new') }}" class="btn-er-accent text-decoration-none" style="display:inline-flex; align-items:center; gap:6px; padding:10px 20px;">
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Réserver
        </a>
    {% endif %}
</div>
{% endblock %}
