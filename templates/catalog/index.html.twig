{% extends 'base.html.twig' %}

{% block title %}Catalogue — EventRent{% endblock %}

{% block body %}

<div class="er-hero-inner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb er-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Catalogue</li>
            </ol>
        </nav>
        <h1>Catalogue{% if total %} — <span style="color:var(--er-accent);">{{ total }} équipement{{ total > 1 ? 's' : '' }}</span>{% endif %}</h1>
    </div>
</div>

{% set hasFilters = filter.catId or filter.dispo or filter.prixMax %}
{% if hasFilters %}
<div style="background:var(--er-surface); border-bottom:1px solid var(--er-border);">
    <div class="container py-3 d-flex align-items-center gap-2 flex-wrap">
        <span style="font-size:.8125rem; font-weight:600; color:var(--er-muted-text); margin-right:4px;">Filtres actifs :</span>
        {% for cat in categories %}
            {% if filter.catId == cat.id %}
                <a href="{{ path('catalog_index', app.request.query.all|merge({(params.cat): null})) }}" class="er-filter-chip" aria-label="Supprimer filtre {{ cat.name }}">
                    {{ cat.name }} <span class="remove" aria-hidden="true">×</span>
                </a>
            {% endif %}
        {% endfor %}
        {% if filter.dispo %}
            <a href="{{ path('catalog_index', app.request.query.all|merge({(params.dispo): null})) }}" class="er-filter-chip" aria-label="Supprimer filtre Disponibles">
                Disponibles <span class="remove" aria-hidden="true">×</span>
            </a>
        {% endif %}
        {% if filter.prixMax and filter.prixMax < priceRangeMax %}
            <a href="{{ path('catalog_index', app.request.query.all|merge({(params.prix_max): null})) }}" class="er-filter-chip" aria-label="Supprimer filtre prix maximum">
                ≤ {{ filter.prixMax }} € / jour <span class="remove" aria-hidden="true">×</span>
            </a>
        {% endif %}
    </div>
</div>
{% endif %}

<div class="container py-5">
    <div class="row g-4">

        <aside class="col-lg-3 d-none d-lg-block" aria-label="Filtres">
            <form method="get" action="{{ path('catalog_index') }}" class="er-filter-sidebar">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h2 class="er-filter-title mb-0">
                        <i class="bi bi-funnel me-2" aria-hidden="true"></i>Filtres
                    </h2>
                    <a href="{{ path('catalog_index') }}" style="font-size:.8rem; color:var(--er-muted-text);">Réinitialiser</a>
                </div>

                <div class="er-filter-group">
                    <div class="er-filter-group-title">Disponibilité</div>
                    <label class="er-filter-check">
                        <input type="radio" name="{{ params.dispo }}" value="" onchange="this.form.submit()" {{ not filter.dispo ? 'checked' : '' }}>
                        <span class="er-filter-check-label">Tous</span>
                    </label>
                    <label class="er-filter-check">
                        <input type="radio" name="{{ params.dispo }}" value="{{ EqStatus.AVAILABLE }}" onchange="this.form.submit()" {{ filter.dispo == EqStatus.AVAILABLE ? 'checked' : '' }}>
                        <span class="er-filter-check-label">Disponibles uniquement</span>
                    </label>
                </div>

                <div class="er-filter-group">
                    <div class="er-filter-group-title">Catégorie</div>
                    {% for cat in categories %}
                        <label class="er-filter-check">
                            <input type="radio" name="{{ params.cat }}" value="{{ cat.id }}" onchange="this.form.submit()" {{ filter.catId == cat.id ? 'checked' : '' }}>
                            <span class="er-filter-check-label">{{ cat.name }}</span>
                            <span class="er-filter-check-count">{{ countMap[cat.id]|default(0) }}</span>
                        </label>
                    {% endfor %}
                </div>

                <div class="er-filter-group">
                    <div class="er-filter-group-title">Prix / jour</div>
                    <input type="range" class="er-range mb-3" name="{{ params.prix_max }}" min="0" max="{{ priceRangeMax }}" value="{{ filter.prixMax|default(priceRangeMax) }}" onchange="this.form.submit()" aria-label="Prix maximum">
                    <div class="d-flex justify-content-between" style="font-size:.875rem;">
                        <span>0 €</span>
                        <span style="font-weight:700; color:var(--er-primary);">≤ {{ filter.prixMax|default(priceRangeMax) }} €</span>
                        <span>{{ priceRangeMax }} €</span>
                    </div>
                </div>

                {% if filter.sort %}<input type="hidden" name="{{ params.sort }}" value="{{ filter.sort }}">{% endif %}
                <button type="submit" class="btn-er-primary w-100 mt-2">Appliquer les filtres</button>
            </form>
        </aside>

        <div class="col-lg-9">
            <div class="er-sort-bar">
                <div class="d-flex align-items-center gap-2">
                    <span class="er-results-count"><strong>{{ total }}</strong> résultat{{ total > 1 ? 's' : '' }}</span>
                </div>
                <form method="get" class="d-flex align-items-center gap-2">
                    {% if filter.catId %}<input type="hidden" name="{{ params.cat }}" value="{{ filter.catId }}">{% endif %}
                    {% if filter.dispo %}<input type="hidden" name="{{ params.dispo }}" value="{{ filter.dispo }}">{% endif %}
                    {% if filter.prixMax %}<input type="hidden" name="{{ params.prix_max }}" value="{{ filter.prixMax }}">{% endif %}
                    <label for="sort-select" class="er-form-label mb-0" style="font-size:.875rem; white-space:nowrap;">Trier par :</label>
                    <select id="sort-select" name="{{ params.sort }}" class="form-select form-select-sm" style="width:auto; min-height:auto; height:38px;" onchange="this.form.submit()" aria-label="Trier les résultats">
                        {% for value, label in sortOptions %}
                            <option value="{{ value }}" {{ filter.sort == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </form>
            </div>

            <div class="er-catalog-grid">
                {% for e in equipment %}
                    {% set rating = avgRatings[e.id] %}
                    {% set reviewCount = e.reviews|length %}
                    {% set isMaint = e.availabilityStatus == EqStatus.MAINTENANCE or e.availabilityStatus == EqStatus.OUT_OF_SERVICE %}
                    <article class="er-equip-card{{ isMaint ? ' is-maintenance' : '' }}">
                        <div class="er-equip-img">
                            <i class="bi bi-{{ e.type == EqType.VIDEO ? 'projector' : 'speaker' }} text-white"></i>
                            <span class="er-badge {{ isMaint ? 'er-badge-maintenance' : 'er-badge-available' }}">
                                {% if isMaint %}
                                    <i class="bi bi-wrench" aria-hidden="true"></i> En maintenance
                                {% else %}
                                    <i class="bi bi-circle-fill" style="font-size:.5rem" aria-hidden="true"></i> Disponible
                                {% endif %}
                            </span>
                        </div>
                        <div class="er-equip-body">
                            <span class="er-equip-category">{{ e.category.name }}</span>
                            <h3 class="er-equip-name">{{ e.name }}</h3>
                            {% if rating %}
                                <div class="er-equip-stars" aria-label="{{ rating }} sur 5">
                                    {% for i in 1..5 %}
                                        {% if i <= rating|round(0, 'floor') %}<i class="bi bi-star-fill" aria-hidden="true"></i>
                                        {% elseif i - 1 < rating %}<i class="bi bi-star-half" aria-hidden="true"></i>
                                        {% else %}<i class="bi bi-star" aria-hidden="true"></i>
                                        {% endif %}
                                    {% endfor %}
                                    <span class="er-equip-reviews ms-1">({{ reviewCount }})</span>
                                </div>
                            {% endif %}
                            <div class="er-equip-price">{{ e.dailyPrice|number_format(0, ',', ' ') }} € <span>/ jour</span></div>
                        </div>
                        <div class="er-equip-footer">
                            {% if isMaint %}
                                <button class="btn w-100" disabled style="min-height:44px; background:var(--er-muted); color:#94a3b8; border-radius:var(--radius-md); font-weight:600; cursor:not-allowed; border:none;">Indisponible</button>
                            {% else %}
                                <a href="{{ path('catalog_show', {id: e.id}) }}" class="btn-er-primary w-100 text-decoration-none text-center" style="display:block; padding:10px; border-radius:var(--radius-md);">Voir la fiche →</a>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <p class="text-muted">Aucun équipement trouvé.</p>
                {% endfor %}
            </div>

            {% if pages > 1 %}
            <nav class="mt-5 d-flex justify-content-center" aria-label="Pagination">
                <ul class="pagination">
                    <li class="page-item{{ page <= 1 ? ' disabled' : '' }}">
                        <a class="page-link" href="{{ path('catalog_index', app.request.query.all|merge({(params.page): page - 1})) }}" style="min-height:44px; display:flex; align-items:center;">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    </li>
                    {% for i in 1..pages %}
                        <li class="page-item{{ i == page ? ' active' : '' }}"{% if i == page %} aria-current="page"{% endif %}>
                            <a class="page-link" href="{{ path('catalog_index', app.request.query.all|merge({(params.page): i})) }}" style="min-height:44px; display:flex; align-items:center; {{ i == page ? 'background:var(--er-primary); border-color:var(--er-primary);' : 'color:var(--er-foreground);' }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item{{ page >= pages ? ' disabled' : '' }}">
                        <a class="page-link" href="{{ path('catalog_index', app.request.query.all|merge({(params.page): page + 1})) }}" style="min-height:44px; display:flex; align-items:center; color:var(--er-foreground);">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
